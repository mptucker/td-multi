# --- Content source -------------------------------------------------------
# Leave both blank to run entirely from /content/*.json (no database needed).
# Set them to read brands, events, packages, alerts and facts from Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key is only used by scripts/seed-supabase.mjs and the /_admin UI (server side).
SUPABASE_SERVICE_ROLE_KEY=

# TowBoatUS North Texas operational content remains in the existing TIDE
# Supabase project. These are server-only and must not use NEXT_PUBLIC_ names.
TBUS_SUPABASE_URL=
TBUS_SUPABASE_ANON_KEY=
TBUS_SUPABASE_SERVICE_ROLE_KEY=

# --- Authenticated Site Studio --------------------------------------------
# Server-only. The GitHub token should be fine-grained and limited to this
# repository with Contents (read/write), Pull requests (read/write), and
# Deployments (read), and Commit statuses (read) permissions.
OPENAI_API_KEY=
OPENAI_STUDIO_MODEL=gpt-6-astra
GITHUB_STUDIO_TOKEN=
GITHUB_STUDIO_REPO=mptucker/td-multi
GITHUB_STUDIO_BASE_BRANCH=master

# --- Hub -----------------------------------------------------------------------
NEXT_PUBLIC_HUB_ORIGIN=https://texomadestinations.com

# --- Analytics (one GTM container shared across all brand domains) ------------
NEXT_PUBLIC_GTM_ID=

# --- Local dev -------------------------------------------------------------------
# Force a brand when the host header can't be mapped (e.g. localhost).
# You can also use ?brand=paradise or paradise.localhost:3000.
NEXT_PUBLIC_DEFAULT_BRAND=paradise
